# =============================================================================
# DESKLITE - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your production values
# NEVER commit .env files with real credentials to version control
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/desklite?retryWrites=true&w=majority

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-super-secure-jwt-secret-min-64-characters-long-for-production

# NextAuth configuration
NEXTAUTH_SECRET=your-nextauth-secret-min-64-characters-long
NEXTAUTH_URL=https://your-domain.com

# =============================================================================
# API CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Server port (defaults to 5000 if not set)
PORT=5000

# Node environment
NODE_ENV=production

# =============================================================================
# PUPPETEER / PDF GENERATION (Optional)
# =============================================================================
# For production, use Puppeteer's bundled Chromium by leaving this empty
# Or specify a custom Chrome/Chromium path
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# =============================================================================
# RATE LIMITING (Optional - defaults are sensible)
# =============================================================================
# RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100    # requests per window
# AUTH_RATE_LIMIT_MAX=10         # login attempts per window

# =============================================================================
# WHATSAPP INTEGRATION (Future - for automated reminders)
# =============================================================================
# WHATSAPP_API_KEY=your-whatsapp-business-api-key
# WHATSAPP_PHONE_ID=your-phone-number-id

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=info

# =============================================================================
# CORS (The server handles this, but you may need to adjust)
# =============================================================================
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
